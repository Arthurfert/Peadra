<?xml version="1.0" encoding="utf-8"?>
<!-- Animated splash icon: outline draws counterclockwise, then the eye fades in. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/peadra_logo">
    <target
        android:name="outline_path"
        android:animation="@anim/splash_draw_outline" />
    <target
        android:name="outline_stroke_path"
        android:animation="@anim/splash_draw_outline_secondary" />
    <target
        android:name="eye_path"
        android:animation="@anim/splash_fade_eye" />
</animated-vector>
